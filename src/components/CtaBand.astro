---
import Icon from './Icon.astro';
import { site, whatsappLink, telLink, mailLink } from '../data/site';

/** Closing call to action used at the bottom of most pages. */
interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Tell us what slows your business down.',
  body = 'Send a message on WhatsApp, call, or write to us. We reply with questions, then a written quote.',
} = Astro.props;
---

<section class="section section--ink cta-band" aria-labelledby="cta-title">
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      <h2 id="cta-title">{title}</h2>
      <p>{body}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href={whatsappLink('Hi Nexvhira, I would like to discuss a project.')}>
        <Icon name="chat" />
        Message on WhatsApp
      </a>
      <a class="btn btn--ghost" href={telLink}>
        <Icon name="phone" />
        Call {site.phoneDisplay}
      </a>
      <a class="btn btn--ghost" href={mailLink}>
        <Icon name="mail" />
        Email us
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-8);
    border-bottom: 1px solid rgb(232 241 244 / 0.14);
  }
  .cta-band__inner {
    display: grid;
    gap: var(--space-6);
  }
  .cta-band__text {
    max-width: 40rem;
  }
  .cta-band__text p {
    margin-top: var(--space-4);
    color: var(--on-dark-soft);
    font-size: var(--step-1);
  }
  .cta-band h2 {
    color: #fff;
  }
</style>
