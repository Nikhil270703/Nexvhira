---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** A screenshot in a light browser frame whose address bar shows the real host. */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Full URL of the page in the screenshot; only the host is shown. */
  url?: string;
  /** `sizes` attribute for responsive images. */
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { src, alt, url, sizes = '(min-width: 64rem) 36rem, 92vw', loading = 'lazy', class: className } = Astro.props;
const host = url ? new URL(url).host : '';
---

<figure class:list={['frame', className]}>
  <div class="frame__bar" aria-hidden="true">
    <span class="frame__host">{host}</span>
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[400, 640, 800]}
    sizes={sizes}
    loading={loading}
    decoding="async"
    format="webp"
    quality={82}
    class="frame__img"
  />
</figure>

<style>
  .frame {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-frame);
    overflow: hidden;
    box-shadow: var(--shadow-frame);
  }
  .frame__bar {
    display: flex;
    align-items: center;
    height: 2rem;
    padding-inline: 0.75rem;
    background: #f1f5f7;
    border-bottom: 1px solid var(--line);
  }
  .frame__host {
    font-size: 0.75rem;
    line-height: 1;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    padding: 0.3rem 0.6rem;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .frame__img {
    width: 100%;
    height: auto;
  }
</style>
