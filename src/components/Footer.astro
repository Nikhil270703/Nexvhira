---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, whatsappLink, telLink, mailLink } from '../data/site';
import { liveProducts } from '../data/products';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo tone="light" />
      <p>{site.description}</p>
    </div>

    <nav aria-label="Products">
      <h2 class="site-footer__title">Products</h2>
      <ul role="list">
        {liveProducts.map((p) => <li><a href={`/products/${p.slug}/`}>{p.name}</a></li>)}
        <li><a href="/products/">All products and prototypes</a></li>
      </ul>
    </nav>

    <nav aria-label="Company">
      <h2 class="site-footer__title">Company</h2>
      <ul role="list">
        <li><a href="/services/">Services</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__title">Talk to us</h2>
      <ul role="list" class="site-footer__contact">
        <li><a href={whatsappLink()}><Icon name="chat" />WhatsApp</a></li>
        <li><a href={telLink}><Icon name="phone" />{site.phoneDisplay}</a></li>
        <li><a href={mailLink}><Icon name="mail" />{site.email}</a></li>
        <li><span><Icon name="pin" />{site.city}, {site.region}</span></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__base">
    <p>© {year} {site.legalName}. All rights reserved.</p>
    {site.udyamNumber && <p>Udyam registration: {site.udyamNumber}</p>}
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--on-dark-soft);
    padding-block: var(--space-8) var(--space-6);
    font-size: var(--step--1);
  }
  .site-footer a {
    color: var(--on-dark);
    text-decoration: none;
  }
  .site-footer a:hover {
    text-decoration: underline;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: var(--space-7) var(--space-6);
  }
  .site-footer__brand p {
    margin-top: var(--space-4);
    max-width: 22rem;
    line-height: 1.6;
  }
  .site-footer__title {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0;
    color: var(--on-dark-soft);
    margin-bottom: var(--space-3);
  }
  .site-footer ul {
    margin: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--step-0);
  }
  .site-footer__contact a,
  .site-footer__contact span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    overflow-wrap: anywhere;
  }
  .site-footer__contact span {
    color: var(--on-dark);
  }
  .site-footer__contact :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--teal-glow);
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(232 241 244 / 0.14);
  }
  @media (max-width: 60rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 30rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
