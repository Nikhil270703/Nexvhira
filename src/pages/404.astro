---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist on the Nexvhira website." noindex>
  <section class="section">
    <div class="container note-page">
      <h1>This page doesn't exist.</h1>
      <p class="lede">The link may be old or mistyped. These pages will get you back on track.</p>
      <ul role="list" class="note-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products/">Products</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .note-page {
    max-width: 44rem;
  }
  .note-page h1 {
    font-size: var(--step-4);
  }
  .note-page .lede {
    margin-top: var(--space-5);
  }
  .note-links {
    margin: var(--space-6) 0 0;
    border-top: 1.5px solid var(--ink);
  }
  .note-links li {
    border-bottom: 1px solid var(--line-strong);
  }
  .note-links a {
    display: block;
    padding-block: var(--space-4);
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 106%;
    font-size: var(--step-1);
    text-decoration: none;
  }
  .note-links a:hover {
    text-decoration: underline;
  }
</style>
