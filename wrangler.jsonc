{
  // Cloudflare Workers static-assets config. The site is fully static:
  // `npm run build` writes ./dist and `npx wrangler deploy` uploads it.
  // "name" must match the Worker name you pick in the Cloudflare dashboard.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexvhira",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
